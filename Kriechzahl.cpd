"Kriechzahl Beton"
'Bei vorwiegend konstanter oder zunehmender Beanspruchung und wenn keine bedeutenden Entlastungsvorgänge berücksichtigt werden müssen, kann die Kriechzahl wie folgt abgeschätzt werden.

'Einfluss der Betonfestigkeit'
β_fc = 2.7'Für C 30/37'

"Beiwert relative Luftfeuchte"
'<img style="width:15cm;" src="C:/Users/p.gitz/OneDrive - Bänziger Partner AG/Calcpad/Images/image_2250053086605326851.png" alt="image_2250053086605326851.png">
b = 1m'Breite Rechteck'
h = 2m'Höhe Rechteck'
A_c = b*h'Betonquerschnitssfläche
u = 2*b + 2*h'Umfang'
h_0 = 2*A_c/u|mm'Länge des umschnürten Bereichs'
RH = 50%
φ_RH = 1.5

"Beiwerte"
'Temperaturabweichung'
'<img style="width:6cm;" src="C:/Users/p.gitz/OneDrive - Bänziger Partner AG/Calcpad/Images/image_4002176967478351108.png" alt="image_4002176967478351108.png">
k_T = 1.00
'Beiwerte zur Berücksichtigung des Betonalters bei Einwirkungsbeginn und Beiwert zur Berücksichtigung der Lastdauer.'
'<img style="width:15cm;" src="C:/Users/p.gitz/OneDrive - Bänziger Partner AG/Calcpad/Images/image_1469952661188340219.png" alt="image_1469952661188340219.png">
'Beiwert des Betonalters bei Einwirkungsbeginn'
t_0 = 7d
β_1 = 0.7
'Beiwert Lastdauer'
t = 50y
t - t_0
β_2 = 1
"Kriechzahl"
φ = φ_RH*β_fc*β_1*β_2

