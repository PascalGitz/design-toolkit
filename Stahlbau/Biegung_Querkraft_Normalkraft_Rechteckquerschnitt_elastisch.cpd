"Elastischer Spannungsnachweis für Biegung, Querkraft und Normalkraft bei einem Rechteckquerschnitt"
'Hirt, Bez, Nussbaumer. (2018) Stahlbau (TGC Band 10). Kp 4.6.4'

'<img style="width:15cm;" src="./Images/PDFXEdit_BUaSZfLmEx.png" alt="PDFXEdit_BUaSZfLmEx.png">

'Einwirkungen'
N_Ed = 200kN
M_yEd = 30kN*m
V_zEd = -500*kN

'Geometrie'
t = 20mm
h = 300mm

'Material'
f_y = 235N/mm^2
γ_M = 1.05
f_yd(z) = f_y/γ_M
f_yd(0)

'Querschnittswerte'
A = t*h
I_y = t*h^3/12

S_y(z) = t/2*(h^2/4 - z^2)|mm^3
S_y(0mm)

σ_xEd(z) = N_Ed/A + M_yEd/I_y*z|N/mm^2
σ_xEd(-h/2)
σ_xEd(h/2)


τ_zxEd(z) = V_zEd*abs(S_y(z))/(t*I_y)|N/mm^2
τ_zxEd(0mm)

'von Mises Vergleichsspannung'
σ_gEd(z) = sqrt(σ_xEd(z)^2 + 3*τ_zxEd(z)^2)|N/mm^2

'<strong>Grafischer Nachweis</strong>'

'Normalspannung σ_x(z=x)'
$Plot{σ_xEd(z) & f_yd(z) & -f_yd(z) @ z = -h/2 : h/2}

'Schubspannung τ_zx(z=x)'
$Plot{τ_zxEd(z) & f_yd(z) & -f_yd(z) @ z = -h/2 : h/2}

'Nachweis mittels von Mises Vergleichsspannung σ_g(z=x)'
$Plot{σ_gEd(z) & f_yd(z) @ z = -h/2 : h/2}













