'<strong>Wandreibungswinkel</strong>'

'<img style="width:15cm;" src="C:/Users/p.gitz/Projekte/Calcs/Geotechnik/Images/image_5945004934698238644.png" alt="image_5945004934698238644.png">

'<strong>Eingabewerte</strong>'
φ = 36deg'Innerer Reibungswinkel'
β = 20deg'Hangneigung'
α = 0deg'Wandneigung'
δ = φ'Wandreibungswinkel'

'<strong>Erddruckbeiwerte</strong>'
'Erdruhedruck:'
K_0 = (1 - sin(φ))*(1 + sin(β))/cos(β)

'Aktiver Erddruckbeiwert:'
K_a = cos(φ + α)^2/(cos(α)^2*cos(δ - α)*(1 + ((sin(φ + δ)*sin(φ - β))/(cos(δ - α)*cos(α + β)))^0.5)^2)

'Passiver Erddruckbeiwert:'
K_p = cos(φ - α)^2/(cos(α)^2*cos(δ - α)*(1 - ((sin(φ - δ)*sin(φ + β))/(cos(δ - α)*cos(α + β)))^0.5)^2)