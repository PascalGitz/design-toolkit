"Die nicht abgestütze, im Boden eingespannte Wand"
' Nach Lang Huder'

'<img style="height:293pt; width:528pt;" src="./Images/image_7343402607576745464.png" alt="image_7343402607576745464.png">

'Parameter
Kah = 0.29
Kph = 4.8

gamma_erd = 20kN/m^3
gamma_w = 10kN/m^3
gamma_erd_eff = gamma_erd - gamma_w
DeltaH = 0m'Höhendifferenz Wasserspiegel aktive und passive Seite
H = 3.6m

gamma_M = 1.4' Partialfaktor in Lang Huder
gamma_G = 1.35

t0 = 3.8m'initiale Annahme'

'Berechnungen
z0 = H*Kah/(1/gamma_M*Kph - Kah)
iL = DeltaH/(t0 + z0)
Ea = 1/2*(H + z0)*H*gamma_erd*Kah*gamma_G
h0 = (H*(1/3*H + z0) + 2/3*z0^2)/(H + z0)
Ep_bar = 1/2*t0^2*((gamma_erd_eff - iL*gamma_w)*1/gamma_M*Kph - gamma_erd_eff*Kah)
t0 = 3*h0*Ea/(Ep_bar - 3*Ea)'Kontrolle mit initialer Annahme
C = Ep_bar - Ea
delta_t = C/(2*gamma_erd*(H + z0 + t0)/gamma_M*Kph)
t = z0 + t0 + delta_t